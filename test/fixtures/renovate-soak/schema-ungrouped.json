{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Soak restated, but the frontend group matches the npm manager only, so the biome.json schema URL is raised in a PR of its own (.github#68). The gate must fail this.",
  "extends": [
    "config:best-practices"
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@biomejs/biome"
      ],
      "groupName": "frontend toolchain"
    }
  ]
}
