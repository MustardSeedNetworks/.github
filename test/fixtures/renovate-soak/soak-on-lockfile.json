{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Soak restated for every npm update type, so lock file maintenance, which has no release timestamp, would never be raised. The gate must fail this.",
  "extends": [
    "config:best-practices"
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict"
    },
    {
      "matchManagers": [
        "npm",
        "custom.regex"
      ],
      "matchPackageNames": [
        "@biomejs/biome"
      ],
      "groupName": "frontend toolchain"
    }
  ]
}
