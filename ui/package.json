{
  "name": "@mustardseednetworks/ui-shared",
  "version": "0.0.0",
  "private": true,
  "description": "Toolchain for the canonical shared UI components. Nothing here is published: the components are copied into each product by scripts/ui_shared.py and verified by hash.",
  "type": "module",
  "engines": {
    "node": "26.13.1",
    "npm": "12.2.3"
  },
  "packageManager": "npm@12.2.3",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
